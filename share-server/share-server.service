[Unit]
Description=MP3 Share Server
After=network.target

[Service]
Type=simple
User=krasava
WorkingDirectory=/home/krasava/mp3_downloader_gui/share-server
ExecStart=/home/krasava/mp3_downloader_gui/share-server/target/release/share-server
Restart=on-failure
RestartSec=5
Environment=SHARE_BIND=127.0.0.1:3000

[Install]
WantedBy=multi-user.target
